# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# On Vercel, set the same keys under Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Canonical site URL. Used for metadataBase, canonical URL and Open Graph tags.
# Leave unset on Vercel and VERCEL_URL is used automatically for previews, but
# set it to your production domain so social previews resolve correctly.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# --- Sentry (optional) -----------------------------------------------------
# Error monitoring. The app falls back to the DSN hard-coded in
# sentry.*.config.ts, and Sentry only initialises when NODE_ENV=production.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Build-time only: used by the Sentry webpack plugin to upload source maps.
# Without it, the upload step is skipped (the build still succeeds).
# Generate at https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
